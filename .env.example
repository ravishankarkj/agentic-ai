APP_NAME=Brain Box With AI
APP_ENV=local
LOG_LEVEL=INFO

# Confluence
CONFLUENCE_URL=https://your-company.atlassian.net/wiki
CONFLUENCE_USERNAME=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token
CONFLUENCE_SPACE_KEYS=ENG,PRODUCT
CONFLUENCE_PAGE_IDS=
CONFLUENCE_PAGE_LIMIT=50

# LLM provider selection: ollama | openai
LLM_PROVIDER=ollama

# Ollama Cloud / compatible endpoint
OLLAMA_BASE_URL=https://your-ollama-endpoint
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_CHAT_MODEL=gemma3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional alternate provider
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval tuning
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=6
DENSE_WEIGHT=0.6
SPARSE_WEIGHT=0.4

# Vector store persistence
VECTOR_STORE_DIR=.data/chroma
VECTOR_COLLECTION_NAME=confluence_docs

# Optional outbound callback after answer generation
RESPONSE_CALLBACK_URL=
RESPONSE_CALLBACK_TIMEOUT_SECONDS=10.0
# none | basic | bearer | oauth
RESPONSE_CALLBACK_AUTH_MODE=oauth
RESPONSE_CALLBACK_USERNAME=
RESPONSE_CALLBACK_PASSWORD=
RESPONSE_CALLBACK_TOKEN=
RESPONSE_CALLBACK_BEARER_TOKEN=

# Used when RESPONSE_CALLBACK_AUTH_MODE=oauth (OAuth2 client credentials grant)
RESPONSE_CALLBACK_TOKEN_URL=https://login.salesforce.com/services/oauth2/token
RESPONSE_CALLBACK_CLIENT_ID=
RESPONSE_CALLBACK_CLIENT_SECRET=
# Fallback lifetime when the token endpoint omits expires_in
RESPONSE_CALLBACK_TOKEN_TTL_SECONDS=3600.0
# Refresh this many seconds before expiry
RESPONSE_CALLBACK_TOKEN_REFRESH_LEEWAY_SECONDS=60.0
